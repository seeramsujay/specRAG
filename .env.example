# ==============================================================================
# SpecRAG Environment Configuration Template (.env.example)
# Rename this file to .env and fill in your keys.
# ==============================================================================

# --- Gemini API Configuration ---
# Set this to use Google Gemini 1.5 Flash (default fallback if Azure OpenAI is not set)
GEMINI_API_KEY="your-gemini-api-key"

# --- Azure OpenAI Configuration ---
# Configure these to connect to Azure OpenAI (GPT-4o) with Structured Outputs
AZURE_OPENAI_API_KEY="your-azure-openai-key"
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2024-06-01"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4o"

# --- Standard OpenAI Configuration (Optional Alternative) ---
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL_NAME="gpt-4o"

# --- Azure AI Search Configuration (Node 1/2 Integration) ---
AZURE_SEARCH_SERVICE_ENDPOINT="https://your-search-service.search.windows.net"
AZURE_SEARCH_INDEX_NAME="datasheets"
AZURE_SEARCH_API_KEY="your-search-api-key"

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
